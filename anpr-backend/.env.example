# Buildathon — copy to .env in the anpr-backend folder and edit.
# Never commit a real .env. Both the backend and the pipeline
# load this .env automatically from the anpr-backend folder —
# a real environment variable always wins over a value here.

# Backend database (FastAPI + PostgreSQL).
# SQLAlchemy 2.x defaults a plain postgresql:// URL to the psycopg
# (v3) driver, but this repo only installs psycopg2-binary, so the
# driver must be named explicitly or test_db fails with
# "No module named 'psycopg'".
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/buildathon

# Pipeline camera — must match the backend (app/data.py).
# HYD01 Hitech City, HYD02 Gachibowli,
# HYD03 Kukatpally (offline), HYD04 Banjara Hills, HYD05
# Begumpet, HYD06 Secunderabad, HYD07 Charminar, HYD08 LB Nagar
# (all online except HYD03).
CAMERA_ID=HYD01

# Video file path, RTSP URL, or webcam index ("0").
VIDEO_SOURCE=0

# FastAPI detections endpoint (backend must be running first).
FASTAPI_URL=http://localhost:8000/api/detections

# Plate-trained YOLOv8 weights (class 0 = plate).
# REQUIRED, NOT in the repo — place the file at
# anpr-backend/models/yolov8-plate.pt and run from anpr-backend.
# yolov8n.pt has no plate class and will not work.
MODEL_PATH=models/yolov8-plate.pt

# Process every Nth frame (default 5).
FRAME_SKIP=5

# Same plate + camera is not re-sent within this many seconds.
DEDUP_SECONDS=30

# Only valid plates at/above this confidence are sent (0-1).
MIN_CONFIDENCE=0.5

# Seconds to wait for one API send attempt (retried once).
API_TIMEOUT_SECONDS=5

# Local log for detections whose API send failed after the retry.
# Written in the anpr-backend folder. An absolute path is used as-is.
FAILED_LOG=failed_detections.jsonl
